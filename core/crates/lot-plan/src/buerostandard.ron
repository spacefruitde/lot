// Bürostandard (2.08): Materialien, Schraffuren und Stiftsets je Maßstab.
//
// VORSCHLAG für M1, von Ben zu prüfen (Prüfpaket M1). Grundlage:
// DIN 1356-1:1995-02 „Bauzeichnungen; Arten, Inhalte und Grundregeln der
// Darstellung“ (Schraffuren für Baustoffe, Liniengruppen) und
// DIN EN ISO 128-20:2002 (Linienbreiten 0,13 bis 1,0 mm).
//
// Schraffurabstände und Linienbreiten in mm auf dem Papier, Winkel in Grad
// gegen die Blattwaagerechte. Farben für die 3D-Ansicht in sRGB.
OfficeStandard(
    materials: {
        "kalksandstein": Material(
            name: "Kalksandstein",
            color: (236, 233, 226),
            cut: Lines(angle: 45.0, spacing: 1.25),
        ),
        "ziegel": Material(
            name: "Ziegel",
            color: (226, 196, 176),
            cut: Lines(angle: 45.0, spacing: 1.25),
        ),
        "mauerwerk": Material(
            name: "Mauerwerk",
            color: (230, 222, 210),
            cut: Lines(angle: 45.0, spacing: 1.25),
        ),
        "stahlbeton": Material(
            name: "Stahlbeton",
            color: (205, 207, 208),
            cut: Cross(angle: 45.0, spacing: 1.25),
        ),
        "beton": Material(
            name: "Beton unbewehrt",
            color: (214, 214, 210),
            cut: Lines(angle: 45.0, spacing: 2.5),
        ),
        "daemmung": Material(
            name: "Dämmung weich (Mineralwolle)",
            color: (240, 226, 160),
            cut: Insulation(soft: true),
        ),
        "daemmung_hart": Material(
            name: "Dämmung hart (WDVS, EPS)",
            color: (244, 238, 214),
            cut: Insulation(soft: false),
        ),
        "putz": Material(
            name: "Putz",
            color: (246, 245, 241),
            cut: Empty,
        ),
        "gipskarton": Material(
            name: "Gipskarton",
            color: (242, 242, 240),
            cut: Empty,
        ),
        "holz": Material(
            name: "Holz",
            color: (214, 180, 132),
            cut: Lines(angle: 45.0, spacing: 3.0),
        ),
        "luftschicht": Material(
            name: "Luftschicht",
            color: (250, 250, 250),
            cut: Empty,
        ),
        "estrich": Material(
            name: "Estrich",
            color: (222, 220, 214),
            cut: Empty,
        ),
        "dachziegel": Material(
            name: "Dachziegel mit Lattung",
            color: (178, 92, 70),
            cut: Empty,
        ),
        "rahmen": Material(
            name: "Fensterrahmen",
            color: (238, 238, 236),
            cut: Empty,
        ),
        "glas": Material(
            name: "Glas",
            color: (186, 206, 214),
            cut: Empty,
        ),
        "tuerblatt": Material(
            name: "Türblatt",
            color: (226, 214, 196),
            cut: Empty,
        ),
        "stahl": Material(
            name: "Stahl",
            color: (96, 100, 106),
            cut: Solid(gray: 0.0),
        ),
        "erdreich": Material(
            name: "Erdreich (gewachsener Boden)",
            color: (132, 150, 96),
            cut: Lines(angle: 135.0, spacing: 2.5),
        ),
        "referenz": Material(
            name: "Referenzmodell (IFC eines Fachplaners)",
            color: (176, 196, 214),
            cut: Solid(gray: 0.82),
        ),
        "kies": Material(
            name: "Kies",
            color: (190, 186, 178),
            cut: Empty,
        ),
        "abdichtung": Material(
            name: "Abdichtung",
            color: (60, 60, 60),
            cut: Solid(gray: 0.0),
        ),
        "klinker": Material(
            name: "Klinker (Vormauerschale)",
            color: (176, 108, 84),
            cut: Lines(angle: 45.0, spacing: 1.25),
        ),
    },
    // Bestand, Abbruch, Neubau (2.05): Füllfarben im Umbauplan. VORSCHLAG M4,
    // die Bauvorlagenverordnungen der Länder verlangen grau, gelb und rot.
    phases: PhaseColors(existing: (170, 170, 170), demolished: (255, 221, 0), new: (226, 35, 26)),
    // Je Maßstabsbereich: Detailgrad und Stifte. Es gilt der erste Eintrag,
    // dessen `up_to` mindestens so groß ist wie die Maßstabszahl.
    scales: [
        // 1:50 und größer: alle Schichten mit Materialschraffur.
        ScaleStyle(
            up_to: 50.0,
            detail: Fine,
            pens: Pens(cut: 0.7, layer: 0.25, hatch: 0.18, view: 0.35, hidden: 0.25, grid: 0.18, annotation: 0.25),
            text: 3.5,
            // Raumstempel: Name und Zeilen für Nummer und Fläche, Normschrift nach ISO 3098.
            space_name: 3.5,
            space_text: 2.5,
            dimension_text: 2.5,
            grid_bubble: 10.0,
        ),
        // 1:100: Tragschicht schraffiert, weitere Schichten nur als Linie.
        ScaleStyle(
            up_to: 100.0,
            detail: Medium,
            pens: Pens(cut: 0.5, layer: 0.18, hatch: 0.13, view: 0.25, hidden: 0.18, grid: 0.13, annotation: 0.18),
            text: 2.5,
            space_name: 2.5,
            space_text: 1.8,
            dimension_text: 1.8,
            grid_bubble: 8.0,
        ),
        // 1:200 und kleiner: Wände als gefüllte Fläche ohne Schichten.
        ScaleStyle(
            up_to: 100000.0,
            detail: Coarse,
            pens: Pens(cut: 0.35, layer: 0.13, hatch: 0.13, view: 0.18, hidden: 0.13, grid: 0.13, annotation: 0.18),
            text: 2.0,
            space_name: 2.5,
            space_text: 1.8,
            dimension_text: 1.8,
            grid_bubble: 6.0,
        ),
    ],
    // Voreinstellungen jeder Ansicht (ADR 0050): gelten, solange weder Vorlage
    // noch Ansicht etwas anderes setzen.
    views: ViewDefaults(scale: 100.0, site_scale: 500.0, cut_height: 1.0, phase: All, faded_below: true),
    // Ansichtsvorlagen aus Bausteinen (Maßstab mit Detailgrad, Bauzustand,
    // Thema); ein Baustein, der fehlt, steuert nichts. Vorschlag, Ben prüft.
    templates: [
        (name: "Entwurf 1:200", scale: Some((scale: 200.0))),
        (name: "Bauantrag 1:100", scale: Some((scale: 100.0)), phase: Some(All)),
        (name: "Werkplan 1:50", scale: Some((scale: 50.0))),
        (name: "Präsentation", theme: Some("Präsentation")),
        (name: "Umbauplan", phase: Some(All)),
        (name: "Flächenplan", theme: Some("Flächen")),
        (name: "Brandschutzplan", theme: Some("Brandschutz")),
    ],
    // Themen: Regeln nach Eigenschaften; je Bauteil gilt die erste, die trifft.
    // Farben sind ein Vorschlag, Ben prüft.
    themes: [
        (name: "Präsentation", presentation: true),
        (name: "Flächen", rules: [
            (name: "Nutzungsfläche", when: [Kind(Space), Usage("NUF")], then: Color((250, 228, 160))),
            (name: "Technikfläche", when: [Kind(Space), Usage("TF")], then: Color((214, 214, 214))),
            (name: "Verkehrsfläche", when: [Kind(Space), Usage("VF")], then: Color((200, 224, 244))),
            (name: "Maßketten ausblenden", when: [Kind(Dimension)], then: Hide),
        ]),
        (name: "Brandschutz", rules: [
            (name: "Brandwand", when: [Kind(Wall), Property(FireRating, "Brandwand")], then: Color((128, 0, 0))),
            (name: "F90", when: [Kind(Wall), Property(FireRating, "F90")], then: Color((226, 35, 26))),
            (name: "F60", when: [Kind(Wall), Property(FireRating, "F60")], then: Color((245, 150, 40))),
            (name: "F30", when: [Kind(Wall), Property(FireRating, "F30")], then: Color((60, 160, 70))),
            (name: "Übrige Wände grau", when: [Kind(Wall)], then: Gray),
            (name: "Maßketten ausblenden", when: [Kind(Dimension)], then: Hide),
        ]),
    ],
)
