// Testprojekt für Meilenstein M0: eine 5 m lange Wand mit einem Fenster.
// Längen in Metern. Die Bezugslinie der Wand läuft von start nach end, die
// Öffnung sitzt `offset` Meter hinter dem Wandanfang.
Project(
    name: "M0 Wand mit Fenster",
    elements: {
        1: Storey(name: "EG", elevation: 0.0, height: 2.75),
        2: WallType(
            name: "Kalksandstein 30",
            layers: [
                (material: "kalksandstein", thickness: 0.3, function: Structure),
            ],
        ),
        3: Wall(
            storey: 1,
            wall_type: 2,
            start: (x: 0.0, y: 0.0),
            end: (x: 5.0, y: 0.0),
            alignment: Center,
            base_offset: 0.0,
            top: Height(2.6),
        ),
        4: Opening(host: 3, offset: 1.75, width: 1.5, height: 1.3, sill_height: 0.9),
    },
)
