// Testprojekt für Meilenstein M0: eine 5 m lange Wand mit einem Fenster.
// Längen in Metern. Die Wandachse läuft von start nach end, die Dicke liegt
// symmetrisch zur Achse. Die Öffnung sitzt `offset` Meter hinter dem Wandanfang.
Project(
    name: "M0 Wand mit Fenster",
    elements: {
        1: Wall(
            start: (x: 0.0, y: 0.0),
            end: (x: 5.0, y: 0.0),
            thickness: 0.3,
            height: 2.6,
        ),
        2: Opening(
            host: 1,
            offset: 1.75,
            width: 1.5,
            height: 1.3,
            sill_height: 0.9,
        ),
    },
)
